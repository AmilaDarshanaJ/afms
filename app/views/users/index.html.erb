<div class="container">
  <%= link_to "← Back to Dashboard", root_path, class:"btn-back" %><br><br>
  <div class="header-flex">
    <h1>👥 User Management</h1>
    <%= link_to "+ Add New User", new_user_path, class: "btn-primary" %>
  </div>

  <table class="responsive-table">
    <thead>
    <tr>
      <th>ID</th>
      <th>Email</th>
      <th>Role</th>
      <th>Joined</th>
      <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    <% @users.each_with_index do |user, index| %>
      <tr>
        <td data-label="ID">#<%= index + 1 %></td>
        <td data-label="Email" style="font-weight: 500;"><%= user.email_address %></td>

        <td data-label="Role">
            <span class="badge <%= user.admin? ? 'admin' : 'farmer' %>">
              <%= user.role.capitalize %>
            </span>
        </td>

        <td data-label="Joined"><%= user.created_at.strftime("%b %d, %Y") %></td>

        <td data-label="Actions">
          <% if user != Current.user %>
            <div style="display: flex; gap: 5px; justify-content: flex-end;">
              <%= link_to "Edit", edit_user_path(user), class: "btn-sm-edit" %>
              <%= button_to "Delete", user_path(user),
                            method: :delete,
                            onclick: "return confirm('Are you sure you want to delete this user permanently?')",
                            class: "btn-sm-delete" %>
            </div>
          <% else %>
            <span style="color: #95a5a6; font-size: 0.9rem;">(You)</span>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <br>
</div>