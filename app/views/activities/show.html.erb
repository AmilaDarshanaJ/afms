<div class="show-container">

  <!-- 1. Header with Back Button -->
  <div class="page-header">
    <div class="header-left">
      <h1>
        <span class="header-icon">🛠</span>
        Activity Details
      </h1>
    </div>

    <%= link_to activities_path, class: "btn-back" do %>
      <span>← Back to List</span>
    <% end %>
  </div>

  <!-- 2. Notification -->
  <% if notice %>
    <div class="notice-banner">
      ✅ <%= notice %>
    </div>
  <% end %>

  <!-- 3. Main Data Card -->
  <div class="activity-card">

    <!-- Data Grid -->
    <div class="details-grid">
      <!--
        This renders the _activity.html.erb partial.
        The CSS automatically styles the <p> tags into rows.
      -->
      <%= render @activity %>
    </div>

    <!-- Actions Footer -->
    <div class="card-footer">

      <!-- Edit Button -->
      <%= link_to edit_activity_path(@activity), class: "btn-action btn-edit" do %>
        <span>✏️ Edit Activity</span>
      <% end %>

      <!-- Delete Button (Using button_to for reliability) -->
      <%= button_to activity_path(@activity),
                    method: :delete,
                    class: "btn-action btn-delete",
                    onclick: "return confirm('Are you sure you want to delete this activity ?')" do %>
        <span>🗑 Delete</span>
      <% end %>

    </div>

  </div>

</div>