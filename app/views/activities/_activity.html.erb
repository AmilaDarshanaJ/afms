<div id="<%= dom_id activity %>">
  <p>
    <strong>Land:</strong>
    <%= activity.land&.name %>
  </p>

  <p>
    <strong>Start date:</strong>
    <%= activity.start_date %>
  </p>

  <p>
    <strong>End date:</strong>
    <%= activity.end_date %>
  </p>

  <p>
    <strong>Summary:</strong>
    <%= activity.summary %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= activity.status %>
  </p>

</div>
