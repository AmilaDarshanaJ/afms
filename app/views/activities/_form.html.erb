<div class="activity-screen">

  <div class="activity-card">

    <div class="activity-header">
      <div class="header-icon">🛠</div>
      <div class="activity-title">
        <h2><%= action_name == 'edit' ? 'Update Activity' : 'New Activity' %></h2>
      </div>
      <p class="activity-subtitle">Log labor, maintenance, or field operations.</p>
    </div>

    <%= form_with(model: activity, html: { class: "activity-form" }) do |form| %>

      <% if activity.errors.any? %>
        <div class="error-banner">
          <h3>⚠️ Unable to save activity:</h3>
          <ul>
            <% activity.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-row">
        <div class="form-group">
          <%= form.label :land_id, "Select Land Plot", class: "form-label" %>
          <%= form.collection_select :land_id, @lands, :id, :name,
                                     { prompt: "Choose a land..." },
                                     { class: "modern-input" } %>
        </div>

        <div class="form-group">
          <%= form.label :status, "Current Status", class: "form-label" %>
          <%= form.select :status,
                          ['Pending', 'In Progress', 'Completed', 'Cancelled', 'Hold'],
                          { prompt: 'Select...' },
                          { class: "modern-input" } %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= form.label :start_date, class: "form-label" %>
          <%= form.date_field :start_date, class: "modern-input" %>
        </div>

        <div class="form-group">
          <%= form.label :end_date, class: "form-label" %>
          <%= form.date_field :end_date, class: "modern-input" %>
        </div>
      </div>

      <div class="form-group">
        <%= form.label :summary, "Activity Details", class: "form-label" %>
        <%= form.text_area :summary, rows: 4,
                           class: "modern-input",
                           placeholder: "Describe the task, costs, or labor details..." %>
      </div>

      <div class="form-submit">
        <%= form.button class: "btn-submit" do %>
          <span>Save Activity</span>
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        <% end %>
      </div>

    <% end %>
  </div>

  <div class="back-wrapper">
    <%= link_to activities_path, class: "back-link" do %>
      <span>← Cancel & Go Back</span>
    <% end %>
  </div>

</div>