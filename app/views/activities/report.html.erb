<style>
    /* Local Page Styles */
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }

    /* Header Left */
    .header-left { display: flex; flex-direction: column; gap: 5px; }
    .btn-back { display: inline-flex; align-items: center; gap: 6px; color: #6b7280; text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
    .btn-back:hover { color: #10b981; }

    .page-title { font-size: 1.5rem; font-weight: 700; color: #1f2937; display: flex; align-items: center; }
    .count-badge { font-size: 16px; color: #6b7280; font-weight: normal; margin-left: 8px; background: #f3f4f6; padding: 2px 8px; border-radius: 12px; }

    /* Chart Layout */
    .charts-container { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }
    .chart-card {
        flex: 1; min-width: 300px;
        background: white; border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        display: flex; flex-direction: column; overflow: hidden;
        border: 1px solid #e5e7eb;
    }
    .chart-header { padding: 15px 20px; border-bottom: 1px solid #e5e7eb; background-color: #f9fafb; }
    .chart-header h3 { margin: 0; font-size: 0.95rem; font-weight: 600; color: #1f2937; }
    .chart-body { padding: 20px; height: 280px; position: relative; background: white; }

    /* Filters & Tables - Using your existing classes */
    .filters-bar { margin-bottom: 24px; }
    .data-card { background: white; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; }

    @media (max-width: 768px) {
        .charts-container { flex-direction: column; }
    }
</style>

<div class="agri-container">

  <div class="top-bar">
    <div class="header-left">
      <%= link_to root_path, class: "btn-back" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Dashboard
      <% end %>

      <div class="page-title">
        🌾 Activities Report
        <span class="count-badge"><%= @metrics_activities.count %></span>
      </div>
    </div>

    <div class="actions-group">
      <%= link_to report_activities_path(request.parameters.merge(format: :csv)), class: "btn-download btn-csv" do %>
        📊 Export CSV
      <% end %>
      <button onclick="window.print()" class="btn-download btn-pdf">
        🖨️ Save as PDF
      </button>
    </div>
  </div>

  <div class="metrics-grid">
    <div class="metric-card <%= 'active-card' if params[:status].blank? || params[:status] == 'all' %>" onclick="filterByCard('all')">
      <div class="metric-icon" style="background: #e0f2fe; color: #0284c7;">📋</div>
      <div><div class="metric-label">Total</div><div class="metric-value"><%= @metrics_activities.count %></div></div>
    </div>
    <div class="metric-card <%= 'active-card' if params[:status] == 'in_progress' %>" onclick="filterByCard('in_progress')">
      <div class="metric-icon" style="background: #dbeafe; color: #2563eb;">⏳</div>
      <div><div class="metric-label">In Progress</div><div class="metric-value"><%= @metrics_activities.count { |a| a.status.to_s.downcase.include?('progress') } %></div></div>
    </div>
    <div class="metric-card <%= 'active-card' if params[:status] == 'pending' %>" onclick="filterByCard('pending')">
      <div class="metric-icon" style="background: #fef3c7; color: #d97706;">⚠️</div>
      <div><div class="metric-label">Pending</div><div class="metric-value"><%= @metrics_activities.count { |a| a.status.to_s.downcase.include?('pending') } %></div></div>
    </div>
    <div class="metric-card <%= 'active-card' if params[:status] == 'completed' %>" onclick="filterByCard('completed')">
      <div class="metric-icon" style="background: #d1fae5; color: #059669;">✅</div>
      <div><div class="metric-label">Completed</div><div class="metric-value"><%= @metrics_activities.count { |a| a.status.to_s.downcase.include?('completed') } %></div></div>
    </div>
    <div class="metric-card <%= 'active-card' if params[:status] == 'hold' %>" onclick="filterByCard('hold')">
      <div class="metric-icon" style="background: #fee2e2; color: #dc2626;">⏸️</div>
      <div><div class="metric-label">On Hold</div><div class="metric-value"><%= @metrics_activities.count { |a| a.status.to_s.downcase.include?('hold') } %></div></div>
    </div>
    <div class="metric-card <%= 'active-card' if params[:status] == 'cancelled' %>" onclick="filterByCard('cancelled')">
      <div class="metric-icon" style="background: #f3f4f6; color: #4b5563;">🚫</div>
      <div><div class="metric-label">Cancelled</div><div class="metric-value"><%= @metrics_activities.count { |a| a.status.to_s.downcase.include?('cancel') } %></div></div>
    </div>
  </div>

  <div class="charts-container">
    <div class="chart-card">
      <div class="chart-header"><h3>Activities by Status</h3></div>
      <div class="chart-body"><canvas id="statusChart"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-header"><h3>Activities by Land</h3></div>
      <div class="chart-body"><canvas id="landChart"></canvas></div>
    </div>
  </div>

  <div class="filters-bar">
    <%= form_with url: report_activities_path, method: :get, local: true, data: { turbo: false }, class: "filters-form" do |f| %>

      <div class="filter-group search-group">
        <label class="filter-label">Search</label>
        <%= f.text_field :q, value: params[:q], class: "search-input", placeholder: "🔍 e.g. Green Farm...", onchange: "this.form.requestSubmit()" %>
      </div>

      <div class="filter-group">
        <label class="filter-label">From</label>
        <%= f.date_field :date_start, value: params[:date_start], class: "date-input", onchange: "this.form.requestSubmit()" %>
      </div>

      <div class="filter-group">
        <label class="filter-label">To</label>
        <%= f.date_field :date_end, value: params[:date_end], class: "date-input", onchange: "this.form.requestSubmit()" %>
      </div>

      <div class="filter-group">
        <label class="filter-label">Status</label>
        <%= f.select :status,
                     options_for_select([['All Statuses', 'all'], ['Pending', 'pending'], ['In Progress', 'in_progress'], ['Completed', 'completed'], ['On Hold', 'hold'], ['Cancelled', 'cancelled']], params[:status]),
                     {},
                     { class: "filter-select", onchange: "this.form.requestSubmit()" }
        %>
      </div>

      <div class="filter-group reset-group">
        <label class="filter-label">&nbsp;</label>
        <%= link_to report_activities_path, class: "btn-reset", title: "Clear filters" do %>↺ Reset<% end %>
      </div>
    <% end %>
  </div>

  <div class="data-card">
    <table class="agri-table">
      <thead>
      <tr>
        <th>Land / Farmer</th>
        <th>Start Date</th>
        <th>Summary / Task</th>
        <th>Status</th>
      </tr>
      </thead>
      <tbody>
      <% @activities.each do |activity| %>
        <% safe_status = activity.status.to_s.parameterize.underscore %>
        <tr>
          <td data-label="Land">
            <div class="land-info">
              <img src="https://ui-avatars.com/api/?name=<%= activity.land&.name %>&background=10b981&color=fff&size=128" class="avatar" alt="icon">
              <div><div style="color: var(--text-main);"><%= activity.land&.name || "Unassigned" %></div></div>
            </div>
          </td>
          <td data-label="Start Date">📅 <%= activity.start_date.present? ? activity.start_date.strftime("%d %b, %Y") : "N/A" %></td>
          <td data-label="Summary"><%= activity.summary %></td>
          <td data-label="Status"><span class="badge status-<%= safe_status %>"><%= activity.status.to_s.humanize %></span></td>
        </tr>
      <% end %>
      </tbody>
    </table>

    <% if @activities.present? %>
      <div class="pagination-wrapper">
        <div class="page-info">
          Showing <strong><%= @activities.offset_value + 1 %></strong> - <strong><%= @activities.offset_value + @activities.length %></strong> of <strong><%= @metrics_activities.count %></strong>
        </div>
        <div class="page-links">
          <%= paginate @activities, params: request.query_parameters %>
        </div>
      </div>
    <% else %>
      <div id="noResults" style="padding: 40px; text-align: center; color: #6b7280;">🍂 No activities found matching your filters.</div>
    <% end %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // 1. Card Filter Helper
    window.filterByCard = function(statusType) {
        const statusSelect = document.querySelector('select[name="status"]');
        if(statusSelect) {
            statusSelect.value = statusType;
            statusSelect.form.requestSubmit();
        }
    }

    // 2. Chart Generation
    document.addEventListener("DOMContentLoaded", function() {

        // Securely pass data from Rails to JS
        const statusLabels = <%= raw @data_by_status.keys.to_json %>;
        const statusData = <%= raw @data_by_status.values.to_json %>;

        const landLabels = <%= raw @data_by_land.keys.to_json %>;
        const landData = <%= raw @data_by_land.values.to_json %>;

        // Dynamic Colors Helper
        const getStatusColor = (label) => {
            const l = label.toLowerCase();
            if(l.includes('progress')) return '#2563eb';
            if(l.includes('pending')) return '#d97706';
            if(l.includes('completed')) return '#059669';
            if(l.includes('hold')) return '#dc2626';
            if(l.includes('cancel')) return '#4b5563';
            return '#10b981';
        };

        // Render Status Chart (Doughnut)
        const ctxStatus = document.getElementById('statusChart');
        if (ctxStatus) {
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusData,
                        backgroundColor: statusLabels.map(getStatusColor),
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 10 } } }
                }
            });
        }

        // Render Land Chart (Bar)
        const ctxLand = document.getElementById('landChart');
        if (ctxLand) {
            new Chart(ctxLand, {
                type: 'bar',
                data: {
                    labels: landLabels,
                    datasets: [{
                        label: 'Activities Count',
                        data: landData,
                        backgroundColor: '#10b981',
                        borderRadius: 4,
                        barThickness: 30
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { precision: 0 } },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }
    });
</script>