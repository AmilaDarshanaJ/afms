<div class="agri-container">

  <% if notice %>
    <div class="flash-message">
      ✅ <%= notice %>
    </div>
  <% end %>

  <div class="page-header">
    <div class="page-title">
      🌿 Crop Catalog
      <span class="count-badge"><%= @crop_types.count %> items</span>
    </div>
  </div>

  <div class="crop-grid">

    <%= link_to new_crop_type_path, class: "crop-card add-card" do %>
      <div class="add-circle">+</div>
      <div class="add-text">Add New Crop</div>
    <% end %>

    <% @crop_types.each do |crop| %>
      <div class="crop-card">

        <div class="icon-wrapper">
          <img src="https://ui-avatars.com/api/?name=<%= crop.name %>&background=10b981&color=fff&size=128&bold=true" class="crop-icon" alt="<%= crop.name %>">
        </div>

        <div class="card-content">
          <h3 class="crop-name"><%= crop.name %></h3>

          <% if crop.unit.present? %>
            <span class="unit-badge">Unit: <%= crop.unit %></span>
          <% end %>

          <p class="crop-desc">
            <%= crop.description.present? ? crop.description : "No description available." %>
          </p>
        </div>

        <div class="card-actions">
          <%= link_to edit_crop_type_path(crop), class: "action-btn btn-edit" do %>
            ✏️ Edit
          <% end %>

          <%= button_to crop_type_path(crop),
                        method: :delete,
                        class: "action-btn btn-delete",
                        form: { style: "flex: 1;" },
                        data: { turbo_confirm: "Are you sure you want to delete #{crop.name}?" } do %>
            🗑️ Delete
          <% end %>
        </div>

      </div>
    <% end %>

  </div>
</div>