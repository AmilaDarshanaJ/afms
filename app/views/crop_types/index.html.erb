<div class="agri-container">

  <% if notice %>
    <div class="flash-toast">✅ <%= notice %></div>
  <% end %>

  <div class="page-header">
    <div class="page-title">
      Crop Catalog <span class="count-badge"><%= @crop_types.count %></span>
    </div>
  </div>

  <div class="crop-grid">

    <%= link_to new_crop_type_path, class: "crop-card add-card" do %>
      <div class="card-preview">
        <span class="add-plus">+</span>
      </div>
      <div class="card-label">Add New Crop</div>
    <% end %>

    <% @crop_types.each do |crop| %>
      <div class="crop-card">

        <div class="card-preview">
          <img src="https://ui-avatars.com/api/?name=<%= crop.name %>&background=transparent&color=10b981&size=128&bold=true&length=1" class="crop-icon" alt="icon">
        </div>

        <div class="card-label"><%= crop.name %></div>

        <div class="hover-actions">
          <p class="hover-desc">
            <%= crop.description.present? ? truncate(crop.description, length: 50) : "Manage details for #{crop.name}" %>
          </p>

          <div class="action-buttons">
            <%= link_to "Edit", edit_crop_type_path(crop), class: "btn-action" %>

            <%= button_to "Delete", crop_type_path(crop),
                          method: :delete,
                          class: "btn-action delete",
                          form: { style: "display:inline" },
                          data: { turbo_confirm: "Delete #{crop.name}?" }
            %>
          </div>
        </div>

      </div>
    <% end %>

  </div>
</div>