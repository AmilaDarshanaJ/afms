<div class="agri-container">

  <% if notice %>
    <div class="flash-message">
      ✅ <%= notice %>
    </div>
  <% end %>

  <div class="page-header">

    <div class="page-title">
      <h1>🌿 Crop Catalog</h1>
      <span class="count-badge"><%= @crop_types.count %> varieties</span>
    </div>

    <div class="header-actions">
      <%= link_to home_index_path, class: "btn-back" do %>
        <span>← Back to Dashboard</span>
      <% end %>
    </div>

  </div>

  <div class="crop-grid">

    <%= link_to new_crop_type_path, class: "crop-card add-card" do %>
      <div class="add-circle">+</div>
      <div class="add-text">Add New Crop</div>
    <% end %>

    <% @crop_types.each do |crop| %>
      <div class="crop-card">

        <div class="icon-wrapper">
          <img src="https://ui-avatars.com/api/?name=<%= crop.name %>&background=10b981&color=fff&size=128&bold=true&length=1" class="crop-icon" alt="<%= crop.name %>">
        </div>

        <div class="card-content">
          <h3 class="crop-name"><%= crop.name %></h3>

          <% if crop.unit.present? %>
            <span class="unit-badge">Unit: <%= crop.unit %></span>
          <% end %>

          <p class="crop-desc">
            <%= crop.description.present? ? crop.description.truncate(60) : "No description available." %>
          </p>
        </div>

        <div class="card-actions">
          <%= link_to edit_crop_type_path(crop), class: "action-btn btn-edit" do %>
            <span>✏️ Edit</span>
          <% end %>

          <%= button_to crop_type_path(crop),
                        method: :delete,
                        class: "action-btn btn-delete",
                        onclick: "return confirm('Are you sure you want to delete this crop type ?')" do %>
            <span>🗑️ Delete</span>
          <% end %>
        </div>

      </div>
    <% end %>

  </div>
</div>