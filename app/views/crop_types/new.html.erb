<div class="agri-container" style="max-width: 600px;"> <div class="form-header">
  <h1 class="page-title">🌱 Add New Crop</h1>
  <%= link_to "← Back", crop_types_path, class: "back-link" %>
</div>

  <div class="data-card form-card">
    <%= form_with(model: @crop_type, local: true) do |form| %>

      <% if @crop_type.errors.any? %>
        <div class="error-banner">
          <%= pluralize(@crop_type.errors.count, "error") %> prevented saving:
          <ul>
            <% @crop_type.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :name, "Crop Name", class: "filter-label" %>
        <%= form.text_field :name, class: "search-input", placeholder: "e.g. Paddy, Coconut, Chili..." %>
      </div>

      <div class="form-group" style="margin-top: 16px;">
        <%= form.label :description, "Description (Optional)", class: "filter-label" %>
        <%= form.text_area :description, class: "search-input", rows: 4, placeholder: "e.g. Requires high water levels..." %>
      </div>

      <div class="form-actions">
        <%= form.submit "Save Crop", class: "btn-download btn-pdf", style: "width: 100%; justify-content: center;" %>
      </div>

    <% end %>
  </div>

</div>