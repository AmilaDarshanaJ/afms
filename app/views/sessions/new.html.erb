<div class="login-wrapper">
  <div class="login-card">

    <div class="login-header">
      <h2 class="login-title">Welcome Back</h2>
      <p class="login-subtitle">Log in to manage your farm</p>
    </div>

    <% if flash[:alert] %>
      <div class="login-alert login-alert-error">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="login-alert login-alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: sessions_path, method: :post, class: "login-form" do |form| %>

      <div class="input-group">
        <%= form.label :email_address, "Email Address", class: "input-label" %>
        <%= form.email_field :email_address,
                             required: true,
                             autofocus: true,
                             autocomplete: "username",
                             placeholder: "name@example.com",
                             value: params[:email_address],
                             class: "input-field"
        %>
      </div>

      <div class="input-group">
        <%= form.label :password, "Password", class: "input-label" %>
        <%= form.password_field :password,
                                required: true,
                                autocomplete: "current-password",
                                placeholder: "••••••••",
                                maxlength: 72,
                                class: "input-field"
        %>
      </div>

      <div class="form-actions">
        <%= form.submit "Log in", class: "btn-submit" %>
      </div>

      <br>

      <div class="demo-credentials">
        <strong>Note:</strong> Use the demo credentials to log in<br>
        Email: <code>afms.demo@frmcore.com</code><br>
        Password: <code>Omed@123!</code>
      </div>


  <% end %>

<!--    <div class="login-footer">-->
      <%#= link_to "Forgot password?", new_password_path, class: "link-forgot" %>
<!--    </div>-->

  </div>
</div>