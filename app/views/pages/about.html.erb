<div class="about-page-wrapper">

  <div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="badge-new">v1.0 Release</div>
      <h1 class="gradient-text">The Future of <br>Smart Farming</h1>
      <p class="hero-subtitle">
        AFMS combines traditional agricultural wisdom with modern data analytics.
        Track, analyze, and optimize your yield with precision.
      </p>

      <div class="hero-buttons">
        <%= link_to "Go to Dashboard", root_path, class: "btn-primary-glow" %>
        <a href="#features" class="btn-outline-light">Learn More</a>
      </div>
    </div>
  </div>

  <div class="story-section">
    <div class="story-grid">
      <div class="story-text">
        <h4 class="section-label">OUR MISSION</h4>
        <h2>Cultivating Data,<br>Harvesting Success.</h2>
        <p>
          Managing a farm used to be about guesswork and paper notebooks. We built AFMS to change that.
          By digitizing every harvest and activity, we empower plantation managers to make decisions backed by real data.
        </p>
        <div class="check-list">
          <div class="check-item">✅ Zero Paperwork</div>
          <div class="check-item">✅ Real-time Insights</div>
          <div class="check-item">✅ Sustainable Growth</div>
        </div>
      </div>
      <div class="story-visual">
        <div class="visual-card glass-card">
          <div class="icon-floating">🌾</div>
          <div class="stat-floating">
            <span>Active Farmers</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="features-section" id="features">
    <div class="section-header">
      <h2>Power-Packed Modules</h2>
      <p>Everything you need to run a modern plantation.</p>
    </div>

    <div class="features-grid">
      <div class="feature-card card-harvest">
        <div class="card-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20v-9"></path><path d="M6.53 9C4.6 8.8 3 7.1 3 5"></path><path d="M6 13a6 6 0 0 0 12 0"></path><path d="M18 5c0 2.1-1.6 3.8-3.53 4"></path></svg>
        </div>
        <h3>Harvest Analytics</h3>
        <p>Visualize production trends. Track yields by crop type, land area, and season with beautiful interactive charts.</p>
      </div>

      <div class="feature-card card-activity">
        <div class="card-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
        </div>
        <h3>Field Operations</h3>
        <p>Assign tasks, track progress from "Pending" to "Completed", and ensure no field activity goes unnoticed.</p>
      </div>

      <div class="feature-card card-report">
        <div class="card-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <h3>Smart Reports</h3>
        <p>One-click PDF generation and CSV exports. Get the data you need for stakeholders instantly.</p>
      </div>
    </div>
  </div>

  <div class="modern-footer">
    <div class="footer-content">
      <div class="footer-brand">
        <h3>AFMS <span>PRO</span></h3>
        <p>Empowering Agriculture.</p>
      </div>
      <div class="footer-copy">
        &copy; <%= Time.current.year %> AFMS. All rights reserved.
      </div>
    </div>
  </div>

</div>