<div class="show-layout">

  <div class="page-header">

    <div class="header-content">
      <%= link_to harvests_path, class: "back-link" do %>
        <span>← All Harvests</span>
      <% end %>

      <div class="page-title">
        <h1>
          Harvest Details
          <span class="status-badge">Recorded</span>
        </h1>
      </div>
    </div>


  </div>

  <% if notice %>
    <div class="flash-notice">
      ✅ &nbsp; <%= notice %>
    </div>
  <% end %>

  <div class="data-paper">
    <%= render @harvest %>
  </div>

</div>

<div class="header-actions">
  <%= link_to edit_harvest_path(@harvest), class: "btn-action btn-edit" do %>
    <span>✏️ Edit</span>
  <% end %>

  <%= button_to harvest_path(@harvest),
                method: :delete,
                class: "btn-action btn-delete",
                onclick: "return confirm('Are you sure you want to delete this harvest?')" do %>
    🗑 Delete
  <% end %>


</div>