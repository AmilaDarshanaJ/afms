<div class="page-container">

  <div class="header-flex">
    <h1 class="page-title">Harvests</h1>

    <%= form_with url: harvests_path, method: :get, class: "search-form" do |form| %>
      <div class="search-input-group">
        <span class="search-icon">🔍</span>
        <%= form.text_field :query,
                            placeholder: "Search crop or land...",
                            value: params[:query],
                            class: "search-input" %>
        <%= form.submit "Search", class: "search-btn" %>
      </div>
    <% end %>
  </div>

  <p class="notice"><%= notice %></p>

  <div class="table-wrapper">
    <table class="styled-table">
      <thead>
      <tr>
        <th>LAND</th>
        <th>CROP</th>
        <th>PLANNED</th>
        <th>ACTUAL</th>
        <th>AMOUNT</th>
        <th>ACTION</th>
      </tr>
      </thead>

      <tbody>
      <% if @harvests.any? %>
        <% @harvests.each do |harvest| %>
          <tr>
            <td data-label="Land"><strong><%= harvest.land&.name %></strong></td>
            <td data-label="Crop"><%= harvest.crop_type %></td>
            <td data-label="Planned"><%= harvest.planned_date %></td>
            <td data-label="Actual"><%= harvest.actual_date %></td>
            <td data-label="Amount">
              <span class="amount-badge"><%= harvest.amount %> <%= harvest.unit %></span>
            </td>
            <td data-label="">
              <%= link_to "View", harvest, class: "details-btn" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" class="empty-state">
            No harvests found matching "<%= params[:query] %>"
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <div class="footer-actions">

    <div class="pagination-wrapper">
      <%= paginate @harvests, params: { query: params[:query] } %>
    </div>

    <div class="buttons-group">
      <%= link_to "New Harvest", new_harvest_path, class: "action-btn primary" %>
      <%= link_to "Back", home_index_path, class: "action-btn secondary" %>
    </div>

  </div>

</div>