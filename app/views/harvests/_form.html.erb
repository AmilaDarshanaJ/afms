<div class="harvest-wrapper">

  <div class="harvest-card">

    <div class="form-header">
      <div class="header-icon">📝</div>
      <h1 class="harvest-title"><%= action_name == "new" ? "New Harvest" : "Edit Harvest" %></h1>
      <p class="harvest-subtitle">Enter the details of your crop yield below.</p>
    </div>

    <%= form_with(model: @harvest, local: true, novalidate: false) do |form| %>

      <% if @harvest.errors.any? %>
        <div class="error-banner">
          <strong>⚠️ Action Required:</strong>
          <ul style="margin: 5px 0 0 20px; padding: 0;">
            <% @harvest.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :land_id, "Select Land Plot", class: "filter-label" %>
        <%= form.collection_select :land_id, @lands || [], :id, :name,
                                   { prompt: "Choose..." },
                                   {
                                     class: "modern-input #{'input-error' if @harvest.errors[:land_id].any?}",
                                     required: true
                                   }
        %>
        <% if @harvest.errors[:land_id].any? %>
          <span class="inline-err-msg">Land <%= @harvest.errors[:land_id].first %></span>
        <% end %>
      </div>

      <div class="form-group">
        <%= form.label :crop_type, "Crop Variety", class: "filter-label" %>
        <%= form.select :crop_type,
                        options_for_select((@crop_types || []).map { |c| [c.name, c.name, { 'data-unit': c.unit }] }, form.object.crop_type),
                        { prompt: "Select..." },
                        {
                          class: "modern-input #{'input-error' if @harvest.errors[:crop_type].any?}",
                          id: "crop_select",
                          onchange: "updateUnit()",
                          required: true
                        }
        %>
      </div>

      <div class="row-group">
        <div class="form-group">
          <%= form.label :planned_date, class: "filter-label" %>
          <%= form.date_field :planned_date,
                              class: "modern-input #{'input-error' if @harvest.errors[:planned_date].any?}",
                              required: true %>
        </div>

        <div class="form-group">
          <%= form.label :actual_date, class: "filter-label" %>
          <%= form.date_field :actual_date,
                              class: "modern-input #{'input-error' if @harvest.errors[:actual_date].any?}" %>
          <% if @harvest.errors[:actual_date].any? %>
            <span class="inline-err-msg"><%= @harvest.errors[:actual_date].first %></span>
          <% end %>
        </div>
      </div>

      <div class="row-group">
        <div class="form-group">
          <%= form.label :amount, "Amount", class: "filter-label" %>
          <%= form.number_field :amount, step: :any,
                                class: "modern-input #{'input-error' if @harvest.errors[:amount].any?}",
                                placeholder: "0.00",
                                required: true,
                                min: 0 %>
          <% if @harvest.errors[:amount].any? %>
            <span class="inline-err-msg">Amount <%= @harvest.errors[:amount].first %></span>
          <% end %>
        </div>

        <div class="form-group">
          <%= form.label :unit, "Unit", class: "filter-label" %>
          <%= form.text_field :unit, class: "modern-input readonly-input", id: "unit_display", readonly: true %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.button class: "btn-submit" do %>
          <span>Save Record</span>
          <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        <% end %>
      </div>

    <% end %>
  </div>

  <div class="back-wrapper">
    <%= link_to "Cancel", harvests_path, class: "back-link" %>
  </div>

</div>

<script>
    function updateUnit() {
        const select = document.getElementById('crop_select');
        const unitInput = document.getElementById('unit_display');
        if(!select || !unitInput) return;
        const selectedOption = select.options[select.selectedIndex];
        const unit = selectedOption.getAttribute('data-unit');
        unitInput.value = unit ? unit : "";
    }
    document.addEventListener("turbo:load", updateUnit);
</script>