<%= form_with(model: harvest) do |form| %>
  <% if harvest.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(harvest.errors.count, "error") %> prohibited this harvest from being saved:</h2>

      <ul>
        <% harvest.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :land_id, style: "display: block" %>
    <%= form.text_field :land_id %>
  </div>

  <div>
    <%= form.label :planned_date, style: "display: block" %>
    <%= form.date_field :planned_date %>
  </div>

  <div>
    <%= form.label :actual_date, style: "display: block" %>
    <%= form.date_field :actual_date %>
  </div>

  <div>
    <%= form.label :amount, style: "display: block" %>
    <%= form.text_field :amount %>
  </div>

  <div>
    <%= form.label :unit, style: "display: block" %>
    <%= form.text_field :unit %>
  </div>

  <div>
    <%= form.label :crop_type, style: "display: block" %>
    <%= form.text_field :crop_type %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
