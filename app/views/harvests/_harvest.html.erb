<div id="<%= dom_id harvest %>">
  <p>
    <strong>Land:</strong>
    <%= harvest.land.name %>
  </p>


  <p>
    <strong>Planned date:</strong>
    <%= harvest.planned_date %>
  </p>

  <p>
    <strong>Actual date:</strong>
    <%= harvest.actual_date %>
  </p>

  <p>
    <strong>Amount:</strong>
    <%= harvest.amount %>
  </p>

  <p>
    <strong>Unit:</strong>
    <%= harvest.unit %>
  </p>

  <p>
    <strong>Crop type:</strong>
    <%= harvest.crop_type %>
  </p>

</div>
