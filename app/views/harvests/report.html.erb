<div class="report-container">

  <header class="report-header">
    <div class="header-left">
      <%= link_to root_path, class: "btn-back" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Back to Dashboard
      <% end %>

      <div class="title-group">
        <h1>
          Harvest Report
          <span class="count-badge"><%= @harvests.total_count rescue @harvests.count %></span>
        </h1>
      </div>
    </div>

    <div class="header-actions">
      <%= link_to report_harvests_path(format: :csv, params: request.query_parameters.except(:page)), class: "btn btn-white" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Export CSV
      <% end %>

      <%= link_to report_pdf_harvests_path(format: :pdf, params: request.query_parameters), class: "btn btn-dark" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        Save as PDF
      <% end %>
    </div>
  </header>

  <div class="filter-container">
    <%= form_with url: report_harvests_path, method: :get, local: true, class: "filter-form" do |f| %>

      <div class="filter-group" style="flex: 2;">
        <label>Land</label>
        <%= f.select :land_id, options_from_collection_for_select(@lands, :id, :name, params[:land_id]), { include_blank: "Select Land..." }, { class: "form-input" } %>
      </div>

      <div class="filter-group">
        <label>From Date</label>
        <%= f.date_field :start_date, value: params[:start_date], class: "form-input" %>
      </div>

      <div class="filter-group">
        <label>To Date</label>
        <%= f.date_field :end_date, value: params[:end_date], class: "form-input" %>
      </div>

      <div class="filter-group">
        <label>Crop Type</label>
        <%= f.select :crop_type, options_from_collection_for_select(@crop_types, :name, :name, params[:crop_type]), { include_blank: "All Crops" }, { class: "form-input" } %>
      </div>

      <div class="filter-group" style="flex: 0 0 auto; display:flex; gap: 10px;">
        <%= f.submit "Filter", class: "btn btn-primary", style: "height: 42px;" %>
        <%= link_to "Reset", report_harvests_path, class: "btn btn-reset" %>
      </div>
    <% end %>
  </div>

  <div class="charts-container">
    <div class="chart-card">
      <div class="chart-header">
        <h3>Harvest by Crop</h3>
      </div>
      <div class="chart-body">
        <canvas id="cropChart"></canvas>
      </div>
    </div>

    <div class="chart-card">
      <div class="chart-header">
        <h3>Harvest by Land</h3>
      </div>
      <div class="chart-body">
        <canvas id="landChart"></canvas>
      </div>
    </div>
  </div>

  <div class="table-card">
    <% if @harvests.any? %>
      <div class="table-responsive">
        <table class="custom-table">
          <thead>
          <tr>
            <th>Land / Crop</th>
            <th>Harvest Date</th>
            <th>Quantity / Unit</th>
            <th>Status</th>
          </tr>
          </thead>
          <tbody>
          <% @harvests.each do |harvest| %>
            <tr>
              <td>
                <div class="land-info">
                  <% avatar_class = ["", "orange", "blue"].sample %>
                  <div class="avatar <%= avatar_class %>">
                    <%= harvest.land.name[0..1].upcase %>
                  </div>
                  <div class="info-text">
                    <h4><%= harvest.land.name %></h4>
                    <p><%= harvest.crop_type %></p>
                  </div>
                </div>
              </td>
              <td>
                <div class="date-text">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  <%= harvest.actual_date.strftime("%d %b, %Y") %>
                </div>
              </td>
              <td>
                  <span class="amount-text">
                    <%= number_with_delimiter(harvest.amount) %> <%= harvest.unit %>
                  </span>
              </td>
              <td>
                <span class="status-badge completed">Completed</span>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>

      <div class="pagination-footer">
        <div class="pagination-info">
          <%= page_entries_info @harvests %>
        </div>

        <div class="pagination-links">
          <%= paginate @harvests, window: 2, outer_window: 1 %>
        </div>
      </div>

    <% else %>
      <div class="empty-state">
        <h3>No records found</h3>
        <p>Try adjusting your filters.</p>
      </div>
    <% end %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        // 1. DATA FROM RAILS
        const cropLabels = <%= raw @data_by_crop.keys.to_json %>;
        const cropData = <%= raw @data_by_crop.values.to_json %>;

        const landLabels = <%= raw @data_by_land.keys.to_json %>;
        const landData = <%= raw @data_by_land.values.to_json %>;

        // 2. NEW COLORFUL PALETTE
        // This array contains nice distinct colors.
        // Chart.js will cycle through them automatically.
        const colorfulPalette = [
            '#3b82f6', // Bright Blue
            '#10b981', // Emerald Green
            '#f59e0b', // Amber/Orange
            '#ef4444', // Red
            '#8b5cf6', // Violet
            '#06b6d4', // Cyan
            '#ec4899', // Pink
            '#6366f1', // Indigo
            '#f97316'  // Deep Orange
        ];

        // CROP CHART (Doughnut)
        if (document.getElementById('cropChart')) {
            new Chart(document.getElementById('cropChart'), {
                type: 'doughnut',
                data: {
                    labels: cropLabels,
                    datasets: [{
                        data: cropData,
                        backgroundColor: colorfulPalette, // Using the new palette
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right', labels: { usePointStyle: true, boxWidth: 10 } }
                    }
                }
            });
        }

        // LAND CHART (Bar)
        if (document.getElementById('landChart')) {
            new Chart(document.getElementById('landChart'), {
                type: 'bar',
                data: {
                    labels: landLabels,
                    datasets: [{
                        label: 'Total Quantity',
                        data: landData,
                        backgroundColor: colorfulPalette, // Bars will now have different colors
                        borderRadius: 4,
                        barThickness: 30
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f3f4f6' } },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }
    });
</script>