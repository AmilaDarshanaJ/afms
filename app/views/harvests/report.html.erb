<h1 class="report-title">Harvest Report</h1>

<div class="filter-container">
  <%= form_with url: report_harvests_path, method: :get, local: true do |f| %>

    <div class="form-group">
      <label>Select Land</label><br>
      <%= f.select :land_id, options_from_collection_for_select(@lands, :id, :name, params[:land_id]), include_blank: "All Lands" %>
    </div>

    <div class="form-group">
      <label>Start Date</label><br>
      <%= f.date_field :start_date, value: params[:start_date] %>
    </div>

    <div class="form-group">
      <label>End Date</label><br>
      <%= f.date_field :end_date, value: params[:end_date] %>
    </div>

    <br>
    <%= f.submit "Filter Report", class: "btn-primary" %>
  <% end %>
</div>

<br><br>

<h2 class="summary-title">Report Summary</h2>

<div class="table-container">
  <table class="report-table" border="1" width="100%" cellpadding="8">
    <tr>
      <th>Land</th>
      <th>Crop</th>
      <th>Actual Date</th>
      <th>Amount</th>
      <th>Unit</th>
    </tr>

    <% @harvests.each do |h| %>
      <tr>
        <td><%= h.land.name %></td>
        <td><%= h.crop_type %></td>
        <td><%= h.actual_date %></td>
        <td><%= h.amount %></td>
        <td><%= h.unit %></td>
      </tr>
    <% end %>
  </table>
</div>

<br>

<div class="total-container">
  <h3>Total Amount: <%= @total_amount %></h3>
</div>

<div class="back-container">
  <%= link_to "Back to Harvests", harvests_path, class: "btn-secondary" %>
</div>

<br>

<div class="pdf-btn-container">
  <%= link_to "Download Report as PDF", report_pdf_harvests_path(
    format: :pdf,
    land_id: params[:land_id],
    start_date: params[:start_date],
    end_date: params[:end_date]
  ), class: "btn-primary" %>
</div>
