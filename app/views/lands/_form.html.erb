<div class="form-container">

  <div class="form-header">
    <h2>🌱 Create New Land</h2>
    <p>Enter the details of your new cultivation area below.</p>
  </div>

  <%= form_with(model: land, class: "styled-form") do |form| %>

    <% if land.errors.any? %>
      <div class="error-banner">
        <div class="error-icon">⚠️</div>
        <div class="error-content">
          <h4>Please correct the following errors:</h4>
          <ul>
            <% land.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="form-section-card">
      <div class="section-header">
        <span class="step-number">1</span>
        <h3>Basic Information</h3>
      </div>

      <div class="input-grid">
        <div class="input-group full-width">
          <%= form.label :name, "Land Name / Nickname" %>
          <%= form.text_field :name, class: "form-input", placeholder: "e.g. Paddy Field A" %>
        </div>

        <div class="input-group">
          <%= form.label :crop_type, "Primary Crop" %>

          <%= form.select :crop_type,
                          options_from_collection_for_select(CropType.all.order(:name), :name, :name, form.object.crop_type),
                          { prompt: "Select a Crop..." },
                          { class: "form-input" }
          %>
        </div>

        <div class="input-group">
          <%= form.label :address, "Address / Area" %>
          <%= form.text_field :address, class: "form-input", placeholder: "Village or City" %>
        </div>
      </div>
    </div>

    <div class="form-section-card">
      <div class="section-header">
        <span class="step-number">2</span>
        <h3>Location & Size</h3>
      </div>

      <div class="input-grid three-col">
        <div class="input-group">
          <%= form.label :latitude %>
          <%= form.text_field :latitude, class: "form-input", placeholder: "0.0000" %>
        </div>

        <div class="input-group">
          <%= form.label :longitude %>
          <%= form.text_field :longitude, class: "form-input", placeholder: "0.0000" %>
        </div>

        <div class="input-group">
          <%= form.label :extent, "Extent (Acres/Perch)" %>
          <%= form.text_field :extent, class: "form-input", placeholder: "e.g. 2.5 Acres" %>
        </div>
      </div>
    </div>

    <div class="form-section-card">
      <div class="section-header">
        <span class="step-number">3</span>
        <h3>Boundaries & Ownership</h3>
      </div>

      <div class="input-grid two-col">
        <div class="input-group">
          <%= form.label :boundary_north, "North Boundary" %>
          <%= form.text_field :boundary_north, class: "form-input" %>
        </div>

        <div class="input-group">
          <%= form.label :boundary_south, "South Boundary" %>
          <%= form.text_field :boundary_south, class: "form-input" %>
        </div>

        <div class="input-group">
          <%= form.label :boundary_east, "East Boundary" %>
          <%= form.text_field :boundary_east, class: "form-input" %>
        </div>

        <div class="input-group">
          <%= form.label :boundary_west, "West Boundary" %>
          <%= form.text_field :boundary_west, class: "form-input" %>
        </div>

        <div class="input-group full-width">
          <%= form.label :owner_manager_name, "Owner / Manager Name" %>
          <%= form.text_field :owner_manager_name, class: "form-input" %>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", lands_path, class: "btn-cancel" %>
      <%= form.submit "Save Land Details", class: "btn-submit" %>
    </div>

  <% end %>
</div>