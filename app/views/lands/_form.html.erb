  </div>

  <div>
    <%= form.label :longitude, style: "display: block" %>
    <%= form.text_field :longitude %>
  </div>

  <div>
    <%= form.label :extent, style: "display: block" %>
    <%= form.text_field :extent %>
  </div>

  <div>
    <%= form.label :harvest_frequency, style: "display: block" %>
    <%= form.text_field :harvest_frequency %>
  </div>

  <div>
    <%= form.label :boundary_north, style: "display: block" %>
