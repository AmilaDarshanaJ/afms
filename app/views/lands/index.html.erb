<p style="color: green"><%= notice %></p>

<% content_for :title, "Lands" %>

<h1>Lands</h1>

<table class="table">
  <tr>
    <th>Land Name</th>
    <th>Crop Type</th>
    <th>Extent</th>
  </tr>
  <% @lands.each do |land| %>
    <tr>
      <td><%= land.name %></td>
      <td><%= land.crop_type %></td>
      <td><%= land.extent %></td>
      <td><%= link_to "Details..", land %> </td>
    </tr>
  <% end %>
</table>

<%= link_to "New land", new_land_path %><br>
<%= link_to "Back", home_index_path %>
