<div class="land-profile-container">

  <div class="profile-header">
    <div class="header-content">
      <h1 class="land-title">
        <%= @land.name %>
        <span class="crop-badge">🌱 <%= @land.crop_type %></span>
      </h1>
      <p class="land-address">📍 <%= @land.address %></p>
    </div>

    <div class="header-action">
      <%= link_to "&larr; Back to List".html_safe, lands_path, class: "btn-secondary" %>
    </div>

  </div>

  <% if notice %>
    <div class="alert-success"><%= notice %></div>
  <% end %>

  <div class="dashboard-grid">

    <div class="info-card">
      <div class="card-header">
        <h3>📊 Land Details</h3>
      </div>
      <div class="card-body">
        <div class="info-row">
          <span class="label">Total Extent</span>
          <span class="value"><%= @land.extent %> <small>Acres</small></span>
        </div>
        <div class="info-row">
          <span class="label">Owner/Manager</span>
          <span class="value"><%= @land.respond_to?(:owner_manager_name) ? @land.owner_manager_name : "N/A" %></span>
        </div>
      </div>
    </div>

    <div class="info-card">
      <div class="card-header">
        <h3>🌍 Location</h3>
      </div>
      <div class="card-body">
        <div class="geo-box">
          <div class="geo-item">
            <span class="label">Latitude</span>
            <span class="mono-value"><%= @land.latitude %></span>
          </div>
          <div class="geo-item">
            <span class="label">Longitude</span>
            <span class="mono-value"><%= @land.longitude %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="info-card full-width-mobile">
      <div class="card-header">
        <h3>🚧 Boundaries</h3>
      </div>
      <div class="card-body">
        <div class="boundary-grid">
          <div class="boundary-item">
            <span class="direction">North ⬆️</span>
            <span class="b-value"><%= @land.boundary_north %></span>
          </div>
          <div class="boundary-item">
            <span class="direction">South ⬇️</span>
            <span class="b-value"><%= @land.boundary_south %></span>
          </div>
          <div class="boundary-item">
            <span class="direction">East ➡️</span>
            <span class="b-value"><%= @land.boundary_east %></span>
          </div>
          <div class="boundary-item">
            <span class="direction">West ⬅️</span>
            <span class="b-value"><%= @land.boundary_west %></span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="action-footer">
    <%= link_to "Edit Details", edit_land_path(@land), class: "btn-primary" %>

    <%= button_to land_path(@land),
                  method: :delete,
                  class: "btn-danger",
                  form: { style: "display:inline-block;" }, # Keeps it next to the Edit button
                  data: { turbo_confirm: "Are you sure you want to delete this land permanently?" } do %>
      <span>🗑️ Delete Land</span>
    <% end %>
  </div>

</div>