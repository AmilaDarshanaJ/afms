<div id="<%= dom_id land %>">
  <p>
    <strong>Name:</strong>
    <%= land.name %>
  </p>

  <p>
    <strong>Crop type:</strong>
    <%= land.crop_type %>
  </p>

  <p>
    <strong>Address:</strong>
    <%= land.address %>
  </p>

  <p>
    <strong>Latitude:</strong>
    <%= land.latitude %>
  </p>

  <p>
    <strong>Longitude:</strong>
    <%= land.longitude %>
  </p>

  <p>
    <strong>Extent:</strong>
    <%= land.extent %>
  </p>

  <p>
    <strong>Harvest frequency:</strong>
    <%= land.harvest_frequency %>
  </p>

  <p>
    <strong>Boundary north:</strong>
    <%= land.boundary_north %>
  </p>

  <p>
    <strong>Boundary south:</strong>
    <%= land.boundary_south %>
  </p>

  <p>
    <strong>Boundary east:</strong>
    <%= land.boundary_east %>
  </p>

  <p>
    <strong>Boundary west:</strong>
    <%= land.boundary_west %>
  </p>

  <p>
    <strong>Owner manager name:</strong>
    <%= land.owner_manager_name %>
  </p>

</div>
