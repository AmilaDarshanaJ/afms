<%
  hour = Time.now.hour
  greeting =
    if hour < 12
      "Good Morning"
    elsif hour < 18
      "Good Afternoon"
    else
      "Good Evening"
    end
%>

<div class="agri-dashboard">

  <!-- HERO -->
  <div class="hero-banner">
    <div class="hero-text">
      <h1>
        <%= greeting %>,
        <%= Current.user&.email_address&.split('@')&.first&.capitalize || "Farmer" %> 🌿
      </h1>
      <p>System is running smoothly. Here is your daily overview.</p>
    </div>

    <div class="time-badge">
      <%= Time.now.strftime("%l:%M %p") %>
    </div>
  </div>

  <!-- STATS -->
  <div class="stats-container">

    <div class="stat-card">
      <div class="icon-box green">🌱</div>
      <div class="stat-content">
        <h4>Active Lands</h4>
        <span class="stat-value"><%= defined?(Land) ? Land.count : 0 %></span>
      </div>
    </div>

    <div class="stat-card">
      <div class="icon-box orange">🌾</div>
      <div class="stat-content">
        <h4>Total Harvests</h4>
        <span class="stat-value"><%= defined?(Harvest) ? Harvest.count : 0 %></span>
      </div>
    </div>

    <div class="stat-card">
      <div class="icon-box blue">🚜</div>
      <div class="stat-content">
        <h4>Activities</h4>
        <span class="stat-value"><%= defined?(Activity) ? Activity.count : 0 %></span>
      </div>
    </div>

  </div>

  <!-- FARM MANAGEMENT -->
  <div class="section-title">Farm Management</div>

  <div class="bento-grid">

    <%= link_to lands_path, class: "dash-item green" do %>
      <div>
        <div class="item-icon">🌱</div>
        <div class="item-content">
          <h3>Manage Lands</h3>
          <p>Add, update, view and delete farm lands.</p>
        </div>
      </div>
      <div class="action-arrow">Open →</div>
    <% end %>

    <%= link_to harvests_path, class: "dash-item orange" do %>
      <div>
        <div class="item-icon">🌾</div>
        <div class="item-content">
          <h3>Harvest Records</h3>
          <p>Track and manage harvest cycles.</p>
        </div>
      </div>
      <div class="action-arrow">Manage →</div>
    <% end %>

    <%= link_to activities_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">🚜</div>
        <div class="item-content">
          <h3>Daily Activities</h3>
          <p>Log labor, fertilizer and machinery usage.</p>
        </div>
      </div>
      <div class="action-arrow">Log →</div>
    <% end %>

    <%= link_to crop_types_path, class: "dash-item green" do %>
      <div>
        <div class="item-icon">🌽</div>
        <div class="item-content">
          <h3>Crop Catalog</h3>
          <p>Manage crops and crop types.</p>
        </div>
      </div>
      <div class="action-arrow">View →</div>
    <% end %>

    <%= link_to financial_records_path, class: "dash-item green" do %>
      <div>
        <div class="item-icon">💰</div>
        <div class="item-content">
          <h3>Financial Management</h3>
          <p>Manage incomes and expenses.</p>
        </div>
      </div>
      <div class="action-arrow">View →</div>
    <% end %>

  </div>

  <!-- ANALYTICS -->
  <div class="section-title">Analytics & Settings</div>

  <div class="bento-grid">

    <%= link_to report_harvests_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">📊</div>
        <div class="item-content">
          <h3>Harvest Reports</h3>
          <p>View reports, charts and export data.</p>
        </div>
      </div>
      <div class="action-arrow">Analyze →</div>
    <% end %>

    <%= link_to report_activities_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">📉</div>
        <div class="item-content">
          <h3>Activity Reports</h3>
          <p>Track expenses and operational data.</p>
        </div>
      </div>
      <div class="action-arrow">View →</div>
    <% end %>

    <% if Current.user&.admin? %>
      <%= link_to users_path, class: "dash-item red" do %>
        <div>
          <div class="item-icon">🔐</div>
          <div class="item-content">
            <h3>Admin Panel</h3>
            <p>User management and system settings.</p>
          </div>
        </div>
        <div class="action-arrow">Admin →</div>
      <% end %>
    <% end %>

  </div>

  <footer class="dashboard-footer">
    <p>&copy; <%= Time.current.year %> AgriFarm | Final Year Project</p>
  </footer>

</div>
