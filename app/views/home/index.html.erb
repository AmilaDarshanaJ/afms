<div class="home-container">

  <!-- Page Title -->
  <h1 class="home-title">Welcome to Agri Farm Management System</h1>

  <!-- Dashboard Cards -->
  <div class="card-grid">

    <%= link_to lands_path, class: "dash-card" do %>
      <h3>🌱 Manage Lands</h3>
      <p>View & update land details</p>
    <% end %>

    <%= link_to harvests_path, class: "dash-card" do %>
      <h3>🌾 Harvests</h3>
      <p>Add and manage harvest records</p>
    <% end %>

    <%= link_to activities_path, class: "dash-card" do %>
      <h3>🛠 Activities</h3>
      <p>Track land activity operations</p>
    <% end %>

    <%= link_to report_harvests_path, class: "dash-card" do %>
      <h3>📊 Harvest Reports</h3>
      <p>Generate custom harvest reports</p>
    <% end %>

    <%= link_to report_activities_path, class: "dash-card" do %>
      <h3>📊 Activity Reports</h3>
      <p>Generate custom activity reports</p>
    <% end %>


  </div>

  <!-- Logout Button -->
  <div class="logout-wrapper">
    <%= button_to "🚪 Logout", logout_path, method: :delete, class: "logout-btn" %>
  </div>

</div>
