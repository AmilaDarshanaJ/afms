<%
  hour = Time.now.hour
  greeting = if hour < 12
               "Good Morning"
             elsif hour < 18
               "Good Afternoon"
             else
               "Good Evening"
             end
%>

<div class="agri-dashboard">

  <div class="hero-banner">
    <div class="hero-text">
      <h1><%= greeting %>, <%= Current.user&.email_address&.split('@')&.first&.capitalize || "Farmer" %>! ☀️</h1>
      <p>System is running smoothly. Here is your daily overview.</p>
    </div>
    <div class="time-badge">
      <%= Time.now.strftime("%l:%M %p") %>
    </div>
  </div>

  <div class="stats-container">
    <div class="stat-card">
      <div class="icon-box green">🌱</div>
      <div class="stat-info">
        <h4>Active Lands</h4>
        <div class="value"><%= defined?(Land) ? Land.count : 0 %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="icon-box orange">🌾</div>
      <div class="stat-info">
        <h4>Total Yields</h4>
        <div class="value"><%= defined?(Harvest) ? Harvest.count : 0 %></div>
      </div>
    </div>
    <div class="stat-card">
      <div class="icon-box blue">🚜</div>
      <div class="stat-info">
        <h4>Activities</h4>
        <div class="value"><%= defined?(Activity) ? Activity.count : 0 %></div>
      </div>
    </div>
  </div>

  <div class="section-title first">Farm Management</div>

  <div class="bento-grid">
    <%= link_to lands_path, class: "dash-item green" do %>
      <div>
        <div class="item-icon">🌱</div>
        <div class="item-content">
          <h3>Manage Lands</h3>
          <p>View land details, add new land, and update, edit, or delete land records.</p>
        </div>
      </div>
      <div class="action-arrow">Open Lands →</div>
    <% end %>

    <%= link_to harvests_path, class: "dash-item orange" do %>
      <div>
        <div class="item-icon">🌾</div>
        <div class="item-content">
          <h3>Harvest Records</h3>
          <p>Manage all harvest activities, including viewing, updating, deleting, and adding new harvest records</p>
        </div>
      </div>
      <div class="action-arrow">Manage Harvests →</div>
    <% end %>

    <%= link_to activities_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">🚜</div>
        <div class="item-content">
          <h3>Daily Activities</h3>
          <p>Track labor, fertilization, and machinery usage.</p>
        </div>
      </div>
      <div class="action-arrow">Log Activity →</div>
    <% end %>

    <%= link_to crop_types_path, class: "dash-item green" do %>
      <div>
        <div class="item-icon">🌽</div>
        <div class="item-content">
          <h3>Crop Catalog</h3>
          <p>Add new crops, change crop types, and edit or delete existing records</p>
        </div>
      </div>
      <div class="action-arrow">View Catalog →</div>
    <% end %>
  </div>
 <br><br>
  <div class="section-title">Analytics & Settings</div>

  <div class="bento-grid">
    <%= link_to report_harvests_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">📊</div>
        <div class="item-content">
          <h3>Harvest Reports</h3>
          <p>Visualize yield performance and production trends.</p>
        </div>
      </div>
      <div class="action-arrow">View Analytics →</div>
    <% end %>

    <%= link_to report_activities_path, class: "dash-item blue" do %>
      <div>
        <div class="item-icon">📉</div>
        <div class="item-content">
          <h3>Activity Reports</h3>
          <p>Analyze operational costs and expenses.</p>
        </div>
      </div>
      <div class="action-arrow">View Expenses →</div>
    <% end %>

    <% if Current.user&.admin? %>
      <%= link_to users_path, class: "dash-item red" do %>
        <div>
          <div class="item-icon">🔐</div>
          <div class="item-content">
            <h3>Admin Panel</h3>
            <p>Manage users, security, and system configuration.</p>
          </div>
        </div>
        <div class="action-arrow">System Settings →</div>
      <% end %>
    <% end %>
  </div>

  <footer class="dashboard-footer">
    <p>&copy; <%= Time.now.year %> AgriFarm. Final Year Project.</p>
  </footer>

</div>